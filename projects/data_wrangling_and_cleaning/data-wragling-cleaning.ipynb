# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from IPython.display import display

sns.set_theme(style="whitegrid")

pd.set_option("display.max_columns", None)
pd.set_option("display.float_format", "{:,.2f}".format)

# ============================================================
# 2. CREATE SAMPLE DATASET
# ============================================================

np.random.seed(42)

n = 1000

df = pd.DataFrame({
    "customer_id": np.arange(10001, 10001 + n),
    "age": np.random.normal(35, 10, n).round(),
    "income": np.random.normal(8000000, 2500000, n).round(),
    "city": np.random.choice(
        ["Jakarta", "Bandung", "Surabaya", "Yogyakarta", "Semarang"],
        n
    ),
    "gender": np.random.choice(
        ["Male", "Female"],
        n
    ),
    "purchase_amount": np.random.normal(500000, 180000, n).round(),
    "purchase_count": np.random.poisson(5, n),
    "customer_rating": np.random.normal(4, 0.6, n).round(1),
    "registration_date": pd.date_range(
        start="2024-01-01",
        periods=n,
        freq="D"
    )
})

# ------------------------------------------------------------
# Membuat missing values
# ------------------------------------------------------------

missing_age = np.random.choice(df.index, 30, replace=False)
missing_income = np.random.choice(df.index, 40, replace=False)
missing_city = np.random.choice(df.index, 20, replace=False)
missing_rating = np.random.choice(df.index, 25, replace=False)

df.loc[missing_age, "age"] = np.nan
df.loc[missing_income, "income"] = np.nan
df.loc[missing_city, "city"] = np.nan
df.loc[missing_rating, "customer_rating"] = np.nan


# ------------------------------------------------------------
# Membuat data invalid
# ------------------------------------------------------------

df.loc[10, "age"] = -5
df.loc[20, "age"] = 150
df.loc[30, "income"] = -1000000
df.loc[40, "purchase_amount"] = -50000


# ------------------------------------------------------------
# Membuat outlier
# ------------------------------------------------------------

df.loc[50, "income"] = 100000000
df.loc[60, "purchase_amount"] = 10000000


# ------------------------------------------------------------
# Membuat kategori tidak konsisten
# ------------------------------------------------------------

df.loc[70, "city"] = " jakarta "
df.loc[71, "city"] = "JAKARTA"
df.loc[72, "gender"] = "male"
df.loc[73, "gender"] = "FEMALE"


# ------------------------------------------------------------
# Membuat duplicate rows
# ------------------------------------------------------------

duplicates = df.iloc[[100, 101, 102, 103, 104]].copy()

df = pd.concat(
    [df, duplicates],
    ignore_index=True
)


print("Dataset berhasil dibuat.")
print(f"Shape: {df.shape}")
# ============================================================
# 3. DATA UNDERSTANDING
# ============================================================

print("=" * 60)
print("SHAPE DATA")
print("=" * 60)
print(f"Rows    : {df.shape[0]:,}")
print(f"Columns : {df.shape[1]}")
print("=" * 60)
print("STATISTICAL SUMMARY")
print("=" * 60)
display(df.describe(include="all").T)
print("=" * 60)
print("SAMPLE DATA")
print("=" * 60)
display(df.head(10))
print("=" * 60)
print("COLUMN INFORMATION")
print("=" * 60)
df.info()

# ============================================================
# 4. MISSING VALUE CHECK
# ============================================================

missing_summary = pd.DataFrame({
    "missing_count": df.isna().sum(),
    "missing_percentage": (
        df.isna().mean() * 100
    )
})

missing_summary = missing_summary.sort_values(
    "missing_count",
    ascending=False
)

display(missing_summary)
# ============================================================
# 5. DUPLICATE CHECK
# ============================================================

duplicate_count = df.duplicated().sum()

print(f"Jumlah duplicate rows: {duplicate_count}")

if duplicate_count > 0:
    display(df[df.duplicated(keep=False)].sort_values("customer_id"))
# ============================================================
# 6. INVALID VALUE CHECK
# ============================================================

invalid_age = df[
    (df["age"] < 0) |
    (df["age"] > 100)
]

invalid_income = df[
    df["income"] < 0
]

invalid_purchase = df[
    df["purchase_amount"] < 0
]

print(f"Invalid age              : {len(invalid_age)}")
print(f"Invalid income           : {len(invalid_income)}")
print(f"Invalid purchase amount  : {len(invalid_purchase)}")

```python id="dwc016"
# ============================================================
# 7. CATEGORICAL CONSISTENCY CHECK
# ============================================================

print("Unique city:")
print(df["city"].dropna().unique())

print("\nUnique gender:")
print(df["gender"].dropna().unique())
# ============================================================
# 8. DISTRIBUTION BEFORE CLEANING
# ============================================================

numeric_columns = [
    "age",
    "income",
    "purchase_amount",
    "purchase_count",
    "customer_rating"
]

for column in numeric_columns:

    plt.figure(figsize=(8, 4))

    sns.histplot(
        data=df,
        x=column,
        kde=True
    )

    plt.title(f"Distribution Before Cleaning - {column}")
    plt.xlabel(column)
    plt.ylabel("Frequency")

    plt.tight_layout()
    plt.show()
# ============================================================
# 9. BOXPLOT BEFORE CLEANING
# ============================================================

for column in [
    "age",
    "income",
    "purchase_amount"
]:

    plt.figure(figsize=(8, 3))

    sns.boxplot(
        x=df[column]
    )

    plt.title(f"Boxplot Before Cleaning - {column}")
    plt.xlabel(column)

    plt.tight_layout()
    plt.show()
# ============================================================
# 11. COPY DATASET
# ============================================================

df_clean = df.copy()

print(f"Shape sebelum cleaning: {df_clean.shape}")
# ============================================================
# 12. HANDLE INVALID VALUES
# ============================================================

# Invalid age
df_clean.loc[
    (df_clean["age"] < 0) |
    (df_clean["age"] > 100),
    "age"
] = np.nan

# Invalid income
df_clean.loc[
    df_clean["income"] < 0,
    "income"
] = np.nan

# Invalid purchase amount
df_clean.loc[
    df_clean["purchase_amount"] < 0,
    "purchase_amount"
] = np.nan


print("Invalid values berhasil dikonversi menjadi NaN.")
# ============================================================
# 13. IMPUTATION
# ============================================================

numeric_imputation_columns = [
    "age",
    "income",
    "customer_rating"
]

categorical_imputation_columns = [
    "city",
    "gender"
]


# ------------------------------------------------------------
# Numeric: Median
# ------------------------------------------------------------

for column in numeric_imputation_columns:

    median_value = df_clean[column].median()

    df_clean[column] = df_clean[column].fillna(
        median_value
    )

    print(
        f"{column} → median: {median_value:.2f}"
    )


# ------------------------------------------------------------
# Categorical: Mode
# ------------------------------------------------------------

for column in categorical_imputation_columns:

    mode_value = df_clean[column].mode()[0]

    df_clean[column] = df_clean[column].fillna(
        mode_value
    )

    print(
        f"{column} → mode: {mode_value}"
    )
