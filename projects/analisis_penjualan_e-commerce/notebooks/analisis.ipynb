# ============================================================
# ANALISIS PENJUALAN E-COMMERCE
# Dataset: Online Retail
# ============================================================

import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# ------------------------------------------------------------
# 1. CONFIGURATION
# ------------------------------------------------------------

INPUT_FILE = "./data/Online_Retail.xlsx"
OUTPUT_DIR = "./visualizations"

os.makedirs(OUTPUT_DIR, exist_ok=True)

sns.set_theme(style="whitegrid")


# ------------------------------------------------------------
# 2. LOAD DATA
# ------------------------------------------------------------

df = pd.read_excel(INPUT_FILE)

print("=" * 60)
print("INFORMASI DATASET")
print("=" * 60)

print(f"Jumlah baris   : {df.shape[0]:,}")
print(f"Jumlah kolom   : {df.shape[1]}")
print("\nKolom:")
print(df.columns.tolist())

print("\n5 Data Teratas:")
print(df.head())


# ------------------------------------------------------------
# 3. DATA QUALITY CHECK
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("DATA QUALITY CHECK")
print("=" * 60)

print("\nMissing Values:")
print(df.isnull().sum().sort_values(ascending=False))

print("\nDuplicate Rows:")
print(df.duplicated().sum())

print("\nData Type:")
print(df.dtypes)


# ------------------------------------------------------------
# 4. DATA CLEANING
# ------------------------------------------------------------

# Hapus duplicate
df = df.drop_duplicates().copy()

# Konversi InvoiceDate menjadi datetime
df["InvoiceDate"] = pd.to_datetime(df["InvoiceDate"], errors="coerce")

# Pastikan Quantity dan UnitPrice numerik
df["Quantity"] = pd.to_numeric(df["Quantity"], errors="coerce")
df["UnitPrice"] = pd.to_numeric(df["UnitPrice"], errors="coerce")

# Hapus baris yang tidak memiliki informasi penting
df = df.dropna(
    subset=[
        "InvoiceNo",
        "Description",
        "Quantity",
        "UnitPrice",
        "InvoiceDate"
    ]
).copy()

# ------------------------------------------------------------
# 5. IDENTIFIKASI TRANSAKSI CANCEL / RETURN
# ------------------------------------------------------------

# Pada dataset Online Retail:
# InvoiceNo yang diawali "C" merupakan cancellation.

df["IsCancelled"] = (
    df["InvoiceNo"]
    .astype(str)
    .str.startswith("C")
)

print("\nJumlah transaksi cancellation:")
print(df["IsCancelled"].sum())

print("\nPersentase cancellation:")
print(f"{df['IsCancelled'].mean() * 100:.2f}%")

# Pisahkan transaksi normal dan cancellation
sales_df = df[~df["IsCancelled"]].copy()
cancel_df = df[df["IsCancelled"]].copy()


# ------------------------------------------------------------
# 6. VALIDASI NILAI TRANSAKSI
# ------------------------------------------------------------

# Untuk analisis penjualan, hanya gunakan transaksi dengan:
# Quantity > 0
# UnitPrice > 0

sales_df = sales_df[
    (sales_df["Quantity"] > 0) &
    (sales_df["UnitPrice"] > 0)
].copy()

# Hitung revenue
sales_df["Revenue"] = (
    sales_df["Quantity"] * sales_df["UnitPrice"]
)


# ------------------------------------------------------------
# 7. FEATURE ENGINEERING
# ------------------------------------------------------------

sales_df["Year"] = sales_df["InvoiceDate"].dt.year
sales_df["Month"] = sales_df["InvoiceDate"].dt.month
sales_df["MonthName"] = sales_df["InvoiceDate"].dt.strftime("%b")
sales_df["Day"] = sales_df["InvoiceDate"].dt.day
sales_df["Hour"] = sales_df["InvoiceDate"].dt.hour
sales_df["DayName"] = sales_df["InvoiceDate"].dt.day_name()
sales_df["Date"] = sales_df["InvoiceDate"].dt.date


# ------------------------------------------------------------
# 8. BUSINESS KPI
# ------------------------------------------------------------

total_revenue = sales_df["Revenue"].sum()

total_quantity = sales_df["Quantity"].sum()

total_transactions = sales_df["InvoiceNo"].nunique()

total_customers = sales_df["CustomerID"].nunique()

average_order_value = (
    total_revenue / total_transactions
    if total_transactions > 0
    else 0
)

average_items_per_transaction = (
    total_quantity / total_transactions
    if total_transactions > 0
    else 0
)

print("\n" + "=" * 60)
print("BUSINESS KPI")
print("=" * 60)

print(f"Total Revenue             : £{total_revenue:,.2f}")
print(f"Total Quantity Sold       : {total_quantity:,.0f}")
print(f"Total Transactions        : {total_transactions:,}")
print(f"Total Customers           : {total_customers:,}")
print(f"Average Order Value       : £{average_order_value:,.2f}")
print(
    f"Average Items/Transaction : "
    f"{average_items_per_transaction:.2f}"
)


# ------------------------------------------------------------
# 9. MONTHLY SALES TREND
# ------------------------------------------------------------

monthly_sales = (
    sales_df
    .groupby(["Year", "Month"], as_index=False)
    .agg(
        Revenue=("Revenue", "sum"),
        Transactions=("InvoiceNo", "nunique"),
        Quantity=("Quantity", "sum")
    )
)

monthly_sales["Period"] = pd.to_datetime(
    monthly_sales["Year"].astype(str)
    + "-"
    + monthly_sales["Month"].astype(str)
    + "-01"
)

monthly_sales = monthly_sales.sort_values("Period")

print("\n" + "=" * 60)
print("MONTHLY SALES")
print("=" * 60)

print(monthly_sales)


# Visualisasi monthly revenue

plt.figure(figsize=(12, 5))

sns.lineplot(
    data=monthly_sales,
    x="Period",
    y="Revenue",
    marker="o"
)

plt.title("Monthly Revenue Trend")
plt.xlabel("Period")
plt.ylabel("Revenue")
plt.xticks(rotation=45)
plt.tight_layout()

plt.savefig(
    f"{OUTPUT_DIR}/monthly_revenue.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ------------------------------------------------------------
# 10. TOP 10 PRODUK BERDASARKAN QUANTITY
# ------------------------------------------------------------

top_products_quantity = (
    sales_df
    .groupby("Description", as_index=False)
    .agg(
        Quantity=("Quantity", "sum"),
        Revenue=("Revenue", "sum")
    )
    .sort_values("Quantity", ascending=False)
    .head(10)
)

print("\n" + "=" * 60)
print("TOP 10 PRODUCTS - QUANTITY")
print("=" * 60)

print(top_products_quantity)


plt.figure(figsize=(10, 6))

sns.barplot(
    data=top_products_quantity,
    x="Quantity",
    y="Description"
)

plt.title("Top 10 Products by Quantity Sold")
plt.xlabel("Quantity Sold")
plt.ylabel("Product")
plt.tight_layout()

plt.savefig(
    f"{OUTPUT_DIR}/top_products_quantity.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ------------------------------------------------------------
# 11. TOP 10 PRODUK BERDASARKAN REVENUE
# ------------------------------------------------------------

top_products_revenue = (
    sales_df
    .groupby("Description", as_index=False)
    .agg(
        Revenue=("Revenue", "sum"),
        Quantity=("Quantity", "sum")
    )
    .sort_values("Revenue", ascending=False)
    .head(10)
)

print("\n" + "=" * 60)
print("TOP 10 PRODUCTS - REVENUE")
print("=" * 60)

print(top_products_revenue)


plt.figure(figsize=(10, 6))

sns.barplot(
    data=top_products_revenue,
    x="Revenue",
    y="Description"
)

plt.title("Top 10 Products by Revenue")
plt.xlabel("Revenue")
plt.ylabel("Product")
plt.tight_layout()

plt.savefig(
    f"{OUTPUT_DIR}/top_products_revenue.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ------------------------------------------------------------
# 12. CUSTOMER ANALYSIS
# ------------------------------------------------------------

customer_analysis = (
    sales_df
    .dropna(subset=["CustomerID"])
    .groupby("CustomerID", as_index=False)
    .agg(
        Revenue=("Revenue", "sum"),
        Transactions=("InvoiceNo", "nunique"),
        Quantity=("Quantity", "sum")
    )
)

customer_analysis["AOV"] = (
    customer_analysis["Revenue"]
    / customer_analysis["Transactions"]
)

customer_analysis = customer_analysis.sort_values(
    "Revenue",
    ascending=False
)

print("\n" + "=" * 60)
print("TOP CUSTOMERS")
print("=" * 60)

print(customer_analysis.head(10))


# ------------------------------------------------------------
# 13. CUSTOMER REVENUE CONCENTRATION
# ------------------------------------------------------------

top_10_customer_revenue = (
    customer_analysis
    .head(10)["Revenue"]
    .sum()
)

customer_revenue_contribution = (
    top_10_customer_revenue / total_revenue * 100
)

print(
    "\nKontribusi revenue dari 10 customer terbesar:"
)

print(
    f"{customer_revenue_contribution:.2f}%"
)


# ------------------------------------------------------------
# 14. COUNTRY ANALYSIS
# ------------------------------------------------------------

country_analysis = (
    sales_df
    .groupby("Country", as_index=False)
    .agg(
        Revenue=("Revenue", "sum"),
        Transactions=("InvoiceNo", "nunique"),
        Customers=("CustomerID", "nunique"),
        Quantity=("Quantity", "sum")
    )
    .sort_values("Revenue", ascending=False)
)

print("\n" + "=" * 60)
print("TOP COUNTRIES BY REVENUE")
print("=" * 60)

print(country_analysis.head(10))


plt.figure(figsize=(10, 6))

top_countries = country_analysis.head(10)

sns.barplot(
    data=top_countries,
    x="Revenue",
    y="Country"
)

plt.title("Top 10 Countries by Revenue")
plt.xlabel("Revenue")
plt.ylabel("Country")
plt.tight_layout()

plt.savefig(
    f"{OUTPUT_DIR}/top_countries_revenue.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ------------------------------------------------------------
# 15. TRANSACTION BY HOUR
# ------------------------------------------------------------

hourly_transactions = (
    sales_df
    .groupby("Hour")["InvoiceNo"]
    .nunique()
    .sort_index()
)

peak_hour = hourly_transactions.idxmax()
peak_hour_transactions = hourly_transactions.max()

print("\n" + "=" * 60)
print("PEAK SALES HOUR")
print("=" * 60)

print(
    f"Peak Hour : {peak_hour}:00"
)

print(
    f"Transactions : {peak_hour_transactions:,}"
)


plt.figure(figsize=(10, 5))

sns.lineplot(
    x=hourly_transactions.index,
    y=hourly_transactions.values,
    marker="o"
)

plt.title("Number of Transactions by Hour")
plt.xlabel("Hour")
plt.ylabel("Number of Transactions")
plt.xticks(range(0, 24))
plt.tight_layout()

plt.savefig(
    f"{OUTPUT_DIR}/transactions_by_hour.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ------------------------------------------------------------
# 16. SALES BY DAY OF WEEK
# ------------------------------------------------------------

day_order = [
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday"
]

daily_sales = (
    sales_df
    .groupby("DayName")
    .agg(
        Revenue=("Revenue", "sum"),
        Transactions=("InvoiceNo", "nunique")
    )
    .reindex(day_order)
)

print("\n" + "=" * 60)
print("SALES BY DAY")
print("=" * 60)

print(daily_sales)


plt.figure(figsize=(10, 5))

sns.barplot(
    x=daily_sales.index,
    y=daily_sales["Revenue"].values
)

plt.title("Revenue by Day of Week")
plt.xlabel("Day")
plt.ylabel("Revenue")
plt.xticks(rotation=30)
plt.tight_layout()

plt.savefig(
    f"{OUTPUT_DIR}/revenue_by_day.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ------------------------------------------------------------
# 17. CANCELLATION ANALYSIS
# ------------------------------------------------------------

cancel_quantity = cancel_df["Quantity"].sum()

cancel_transactions = cancel_df["InvoiceNo"].nunique()

print("\n" + "=" * 60)
print("CANCELLATION ANALYSIS")
print("=" * 60)

print(
    f"Cancelled Transactions : {cancel_transactions:,}"
)

print(
    f"Cancelled Quantity     : {cancel_quantity:,}"
)


# ------------------------------------------------------------
# 18. PRODUCT PERFORMANCE SUMMARY
# ------------------------------------------------------------

product_summary = (
    sales_df
    .groupby("Description", as_index=False)
    .agg(
        Quantity=("Quantity", "sum"),
        Revenue=("Revenue", "sum"),
        Transactions=("InvoiceNo", "nunique")
    )
)

product_summary["Average_Revenue_Per_Transaction"] = (
    product_summary["Revenue"]
    / product_summary["Transactions"]
)

product_summary = product_summary.sort_values(
    "Revenue",
    ascending=False
)

print("\n" + "=" * 60)
print("PRODUCT PERFORMANCE SUMMARY")
print("=" * 60)

print(product_summary.head(10))


# ------------------------------------------------------------
# 19. SAVE ANALYSIS RESULTS
# ------------------------------------------------------------

top_products_quantity.to_csv(
    "./data/top_products_quantity.csv",
    index=False
)

top_products_revenue.to_csv(
    "./data/top_products_revenue.csv",
    index=False
)

country_analysis.to_csv(
    "./data/country_analysis.csv",
    index=False
)

customer_analysis.to_csv(
    "./data/customer_analysis.csv",
    index=False
)

monthly_sales.to_csv(
    "./data/monthly_sales.csv",
    index=False
)

product_summary.to_csv(
    "./data/product_summary.csv",
    index=False
)


# ------------------------------------------------------------
# 20. AUTOMATED BUSINESS SUMMARY
# ------------------------------------------------------------

best_product_quantity = (
    top_products_quantity.iloc[0]["Description"]
)

best_product_revenue = (
    top_products_revenue.iloc[0]["Description"]
)

best_country = (
    country_analysis.iloc[0]["Country"]
)

best_day = daily_sales["Revenue"].idxmax()

print("\n" + "=" * 60)
print("BUSINESS INSIGHT SUMMARY")
print("=" * 60)

print(
    f"1. Produk dengan quantity tertinggi : "
    f"{best_product_quantity}"
)

print(
    f"2. Produk dengan revenue tertinggi  : "
    f"{best_product_revenue}"
)

print(
    f"3. Negara dengan revenue tertinggi  : "
    f"{best_country}"
)

print(
    f"4. Hari dengan revenue tertinggi    : "
    f"{best_day}"
)

print(
    f"5. Jam transaksi tertinggi          : "
    f"{peak_hour}:00"
)

print(
    f"6. Kontribusi top 10 customer       : "
    f"{customer_revenue_contribution:.2f}%"
)

print("\nAnalisis selesai.")
print(
    f"Visualisasi tersimpan di folder: {OUTPUT_DIR}"
)
